rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'pxvoffl77@gmail.com' ||
        request.auth.token.email == 'admin@ravenation.pl' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidUser(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.name is string && data.name.size() <= 120 &&
             data.role in ['user', 'artist', 'editor', 'admin'];
    }

    function isValidEvent(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.organizerId is string && data.organizerId.size() <= 128;
    }

    function isValidBooking(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.orderRef is string && data.orderRef.size() <= 64 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.eventId is string && data.eventId.size() <= 128 &&
             data.status in ['confirmed', 'cancelled', 'refunded'];
    }

    // User Profiles (Fans & Artists)
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && (isAdmin() || resource.data.id == request.auth.uid);
      allow create: if isSignedIn() && isOwner(userId) && isValidUser(incoming());
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin()) && isValidUser(incoming()) && incoming().id == existing().id;
      allow delete: if isSignedIn() && (isOwner(userId) || isAdmin());
    }

    // Events collection
    match /events/{eventId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isValidEvent(incoming()) && (incoming().organizerId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (existing().organizerId == request.auth.uid || isAdmin()) && isValidEvent(incoming());
      allow delete: if isSignedIn() && (existing().organizerId == request.auth.uid || isAdmin());
    }

    // Bookings collection
    match /bookings/{bookingId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidBooking(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin()) && isValidBooking(incoming());
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }
  }
}
